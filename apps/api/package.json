{
  "name": "@river/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/postgres.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:unit": "vitest run --coverage --exclude src/postgres.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "ajv": "^8.17.1",
    "fastify": "^5.2.1",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^2.1.9",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
